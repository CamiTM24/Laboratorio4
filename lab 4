/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();

  /* USER CODE BEGIN 2 */

  // Iniciar con todas las salidas apagadas
  mostrarDecadas();
  apagarRGB();
  HAL_GPIO_WritePin(GPIOA, modoled_Pin, 0);

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */

    //-----------------------------------------------------------------//
    // Leer el estado actual de los tres botones
    //-----------------------------------------------------------------//

    int estado1 = HAL_GPIO_ReadPin(GPIOA, B1_Pin);
    int estado2 = HAL_GPIO_ReadPin(GPIOA, B2_Pin);
    int estado3 = HAL_GPIO_ReadPin(GPIOA, B3_Pin);

    //-----------------------------------------------------------------//
    // B3: cambiar el modo cuando se suelta el boton
    //-----------------------------------------------------------------//

    if (estado3 == 1)
    {
      cambioModo = 1;
    }

    if ((cambioModo == 1) && (estado3 == 0))
    {
      HAL_Delay(250);

      // Alternar solamente entre los modos 0 y 1
      modo++;

      if (modo > MODO_RGB)
      {
        modo = MODO_DECADAS;
      }

      cambioModo = 0;
    }

    //-----------------------------------------------------------------//
    // MODO 0: CONTADOR DE DECADAS
    //-----------------------------------------------------------------//

    if (modo == MODO_DECADAS)
    {
      // Apagar el indicador y el LED RGB
      HAL_GPIO_WritePin(GPIOA, modoled_Pin, 0);
      apagarRGB();

      //---------------------------------------------------------------//
      // B1: aumentar el contador al soltar el boton
      //---------------------------------------------------------------//

      if (estado1 == 1)
      {
        salidasube = 1;
      }

      if ((salidasube == 1) && (estado1 == 0))
      {
        HAL_Delay(250);
        contador++;

        // El contador es circular: despues de 4 regresa a 0
        if (contador > 4)
        {
          contador = 0;
        }

        salidasube = 0;
      }

      //---------------------------------------------------------------//
      // B2: disminuir el contador al soltar el boton
      //---------------------------------------------------------------//

      if (estado2 == 1)
      {
        salidabaja = 1;
      }

      if ((salidabaja == 1) && (estado2 == 0))
      {
        HAL_Delay(250);
        contador--;

        // Antes de 0, regresar a 4
        if (contador < 0)
        {
          contador = 4;
        }

        salidabaja = 0;
      }

      // Mostrar el numero actual en los cuatro LEDs
      mostrarDecadas();
    }

    //-----------------------------------------------------------------//
    // MODO 1: CONTROL DEL LED RGB
    //-----------------------------------------------------------------//

    if (modo == MODO_RGB)
    {
      // Encender el indicador y apagar los LEDs del contador
      HAL_GPIO_WritePin(GPIOA, modoled_Pin, 1);
      apagarDecadas();

      //---------------------------------------------------------------//
      // B1: aumentar el contador RGB
      //---------------------------------------------------------------//

      if (estado1 == 1)
      {
        salidasube = 1;
      }

      if ((salidasube == 1) && (estado1 == 0))
      {
        HAL_Delay(250);

        // Detener el contador en su valor maximo
        if (contadorRGB < 6)
        {
          contadorRGB++;
        }

        salidasube = 0;
      }

      //---------------------------------------------------------------//
      // B2: disminuir el contador RGB
      //---------------------------------------------------------------//

      if (estado2 == 1)
      {
        salidabaja = 1;
      }

      if ((salidabaja == 1) && (estado2 == 0))
      {
        HAL_Delay(250);

        // Detener el contador en su valor minimo
        if (contadorRGB > 0)
        {
          contadorRGB--;
        }

        salidabaja = 0;
      }

      // Mostrar el color correspondiente
      mostrarColor();
    }

  }
  /* USER CODE END 3 */
}

