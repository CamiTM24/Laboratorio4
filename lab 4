// Contador de estados entre 0 y 4
int contador = 0;

// Banderas para guardar la pulsacion de los botones
int salidasube = 0;
int salidabaja = 0;
int cambioModo = 0;

// Variable para elegir entre decadas y RGB
int modo = MODO_DECADAS;

// Contador para seleccionar los colores de 0 a 6
int contadorRGB = 0;

/* USER CODE END PV */

