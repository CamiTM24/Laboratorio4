//*********************************************************************//
// MOSTRAR EL CONTADOR DE 0 A 4 EN LOS LEDS
//*********************************************************************//

void mostrarDecadas(void)
{
  // Cada valor enciende solamente el LED correspondiente
  switch (contador)
  {
    case 0:
      apagarDecadas();
      break;

    case 1:
      HAL_GPIO_WritePin(GPIOA, led1_Pin, 1);
      HAL_GPIO_WritePin(GPIOB, led2_Pin, 0);
      HAL_GPIO_WritePin(GPIOB, led3_Pin, 0);
      HAL_GPIO_WritePin(GPIOB, led4_Pin, 0);
      break;

    case 2:
      HAL_GPIO_WritePin(GPIOA, led1_Pin, 0);
      HAL_GPIO_WritePin(GPIOB, led2_Pin, 1);
      HAL_GPIO_WritePin(GPIOB, led3_Pin, 0);
      HAL_GPIO_WritePin(GPIOB, led4_Pin, 0);
      break;

    case 3:
      HAL_GPIO_WritePin(GPIOA, led1_Pin, 0);
      HAL_GPIO_WritePin(GPIOB, led2_Pin, 0);
      HAL_GPIO_WritePin(GPIOB, led3_Pin, 1);
      HAL_GPIO_WritePin(GPIOB, led4_Pin, 0);
      break;

    case 4:
      HAL_GPIO_WritePin(GPIOA, led1_Pin, 0);
      HAL_GPIO_WritePin(GPIOB, led2_Pin, 0);
      HAL_GPIO_WritePin(GPIOB, led3_Pin, 0);
      HAL_GPIO_WritePin(GPIOB, led4_Pin, 1);
      break;
  }
}

//*********************************************************************//
// APAGAR LOS CUATRO LEDS DEL CONTADOR
//*********************************************************************//

void apagarDecadas(void)
{
  HAL_GPIO_WritePin(GPIOA, led1_Pin, 0);
  HAL_GPIO_WritePin(GPIOB, led2_Pin, 0);
  HAL_GPIO_WritePin(GPIOB, led3_Pin, 0);
  HAL_GPIO_WritePin(GPIOB, led4_Pin, 0);
}

//*********************************************************************//
// APAGAR LOS TRES COLORES DEL LED RGB
//*********************************************************************//

void apagarRGB(void)
{
  // En este montaje se utiliza RESET para apagar cada color
  HAL_GPIO_WritePin(GPIOB, Rojo_Pin, 1);
  HAL_GPIO_WritePin(GPIOC, Verde_Pin, 1);
  HAL_GPIO_WritePin(GPIOC, blue_Pin, 1);
}

//*********************************************************************//
// MOSTRAR LOS COLORES DE ACUERDO CON EL CONTADOR RGB
//*********************************************************************//

void mostrarColor(void)
{
  switch (contadorRGB)
  {
    case 0: // Apagado
      apagarRGB();
      break;

    case 1: // Rojo
      HAL_GPIO_WritePin(GPIOB, Rojo_Pin, 1);
      HAL_GPIO_WritePin(GPIOC, Verde_Pin, 0);
      HAL_GPIO_WritePin(GPIOC, blue_Pin, 0);
      break;

    case 2: // Magenta
      HAL_GPIO_WritePin(GPIOB, Rojo_Pin, 1);
      HAL_GPIO_WritePin(GPIOC, Verde_Pin, 0);
      HAL_GPIO_WritePin(GPIOC, blue_Pin, 1);
      break;

    case 3: // Azul
      HAL_GPIO_WritePin(GPIOB, Rojo_Pin, 0);
      HAL_GPIO_WritePin(GPIOC, Verde_Pin, 0);
      HAL_GPIO_WritePin(GPIOC, blue_Pin, 1);
      break;

    case 4: // Cian
      HAL_GPIO_WritePin(GPIOB, Rojo_Pin, 0);
      HAL_GPIO_WritePin(GPIOC, Verde_Pin, 1);
      HAL_GPIO_WritePin(GPIOC, blue_Pin, 1);
      break;

    case 5: // Verde
      HAL_GPIO_WritePin(GPIOB, Rojo_Pin, 0);
      HAL_GPIO_WritePin(GPIOC, Verde_Pin, 1);
      HAL_GPIO_WritePin(GPIOC, blue_Pin, 0);
      break;

    case 6: // Amarillo
      HAL_GPIO_WritePin(GPIOB, Rojo_Pin, 1);
      HAL_GPIO_WritePin(GPIOC, Verde_Pin, 1);
      HAL_GPIO_WritePin(GPIOC, blue_Pin, 0);
      break;
  }
}

