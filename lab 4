//*********************************************************************//
// FUNCION PARA LEER UN BOTON CON ANTIRREBOTE
//*********************************************************************//

uint8_t botonPresionado(GPIO_TypeDef *puerto, uint16_t pin)
{
  // Los botones tienen resistencias pull-down.
  // Cuando se presiona un boton, el pin recibe un estado SET.
  if (HAL_GPIO_ReadPin(puerto, pin) == GPIO_PIN_SET)
  {
    // Esperar un poco para eliminar el rebote mecanico
    HAL_Delay(50);

    // Confirmar que el boton continua presionado
    if (HAL_GPIO_ReadPin(puerto, pin) == GPIO_PIN_SET)
    {
      // Esperar hasta que la persona suelte el boton
      while (HAL_GPIO_ReadPin(puerto, pin) == GPIO_PIN_SET)
      {
      }

      // Pequenio retardo al soltar el boton
      HAL_Delay(50);

      return 1;
    }
  }

  // No se detecto una pulsacion
  return 0;
}

//*********************************************************************//
// FUNCION PARA LEER LOS TRES BOTONES
//*********************************************************************//

void leerBotones(void)
{
  //-------------------------------------------------------------------//
  // B3: cambiar el modo de funcionamiento
  //-------------------------------------------------------------------//

  if (botonPresionado(B3_GPIO_Port, B3_Pin) == 1)
  {
    if (modo == MODO_CONTADOR)
    {
      modo = MODO_RGB;
    }
    else
    {
      modo = MODO_CONTADOR;
    }

    actualizarIndicador();
  }

  //-------------------------------------------------------------------//
  // B1: aumentar el contador del modo activo
  //-------------------------------------------------------------------//

  if (botonPresionado(B1_GPIO_Port, B1_Pin) == 1)
  {
    if (modo == MODO_CONTADOR)
    {
      contadorDecadas++;

      // El contador de decadas es circular
      if (contadorDecadas > 9)
      {
        contadorDecadas = 0;
      }
    }
    else
    {
      // El contador RGB se detiene en 6
      if (contadorRGB < 6)
      {
        contadorRGB++;
      }
    }

    actualizarSalidas();
  }

  //-------------------------------------------------------------------//
  // B2: disminuir el contador del modo activo
  //-------------------------------------------------------------------//

  if (botonPresionado(B2_GPIO_Port, B2_Pin) == 1)
  {
    if (modo == MODO_CONTADOR)
    {
      contadorDecadas--;

      // Al disminuir desde 0, regresar a 9
      if (contadorDecadas < 0)
      {
        contadorDecadas = 9;
      }
    }
    else
    {
      // El contador RGB se detiene en 0
      if (contadorRGB > 0)
      {
        contadorRGB--;
      }
    }

    actualizarSalidas();
  }
}

//*********************************************************************//
// PARTE 1: MOSTRAR EL CONTADOR DE DECADAS
//*********************************************************************//

void mostrarContadorDecadas(void)
{
  // led1 representa el bit con valor 1
  HAL_GPIO_WritePin(led1_GPIO_Port,
                    led1_Pin,
                    (contadorDecadas & 0x01) ? GPIO_PIN_SET : GPIO_PIN_RESET);

  // led2 representa el bit con valor 2
  HAL_GPIO_WritePin(led2_GPIO_Port,
                    led2_Pin,
                    (contadorDecadas & 0x02) ? GPIO_PIN_SET : GPIO_PIN_RESET);

  // led3 representa el bit con valor 4
  HAL_GPIO_WritePin(led3_GPIO_Port,
                    led3_Pin,
                    (contadorDecadas & 0x04) ? GPIO_PIN_SET : GPIO_PIN_RESET);

  // led4 representa el bit con valor 8
  HAL_GPIO_WritePin(led4_GPIO_Port,
                    led4_Pin,
                    (contadorDecadas & 0x08) ? GPIO_PIN_SET : GPIO_PIN_RESET);
}

//*********************************************************************//
// FUNCION PARA ESCRIBIR EN EL LED RGB
//*********************************************************************//

void escribirRGB(GPIO_PinState rojo,
                 GPIO_PinState verde,
                 GPIO_PinState azul)
{
  HAL_GPIO_WritePin(Rojo_GPIO_Port, Rojo_Pin, rojo);
  HAL_GPIO_WritePin(Verde_GPIO_Port, Verde_Pin, verde);
  HAL_GPIO_WritePin(blue_GPIO_Port, blue_Pin, azul);
}

//*********************************************************************//
// PARTE 2: SELECCIONAR EL COLOR DEL LED RGB
//*********************************************************************//

void mostrarColorRGB(void)
{
  switch (contadorRGB)
  {
    case 0:
      // Todos los colores apagados
      escribirRGB(RGB_APAGADO, RGB_APAGADO, RGB_APAGADO);
      break;

    case 1:
      // Rojo
      escribirRGB(RGB_ENCENDIDO, RGB_APAGADO, RGB_APAGADO);
      break;

    case 2:
      // Rojo y azul forman magenta
      escribirRGB(RGB_ENCENDIDO, RGB_APAGADO, RGB_ENCENDIDO);
      break;

    case 3:
      // Azul
      escribirRGB(RGB_APAGADO, RGB_APAGADO, RGB_ENCENDIDO);
      break;

    case 4:
      // Verde y azul forman cian
      escribirRGB(RGB_APAGADO, RGB_ENCENDIDO, RGB_ENCENDIDO);
      break;

    case 5:
      // Verde
      escribirRGB(RGB_APAGADO, RGB_ENCENDIDO, RGB_APAGADO);
      break;

    case 6:
      // Rojo y verde forman amarillo
      escribirRGB(RGB_ENCENDIDO, RGB_ENCENDIDO, RGB_APAGADO);
      break;

    default:
      escribirRGB(RGB_APAGADO, RGB_APAGADO, RGB_APAGADO);
      break;
  }
}

//*********************************************************************//
// PARTE 4: LED INDICADOR DEL MODO
//*********************************************************************//

void actualizarIndicador(void)
{
  if (modo == MODO_RGB)
  {
    // Encender el indicador en el modo RGB
    HAL_GPIO_WritePin(modoled_GPIO_Port, modoled_Pin, GPIO_PIN_SET);
  }
  else
  {
    // Apagar el indicador en el modo contador
    HAL_GPIO_WritePin(modoled_GPIO_Port, modoled_Pin, GPIO_PIN_RESET);
  }
}

//*********************************************************************//
// FUNCION PARA ACTUALIZAR TODAS LAS SALIDAS
//*********************************************************************//

void actualizarSalidas(void)
{
  mostrarContadorDecadas();
  mostrarColorRGB();
  actualizarIndicador();
}

